# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/grasp_electric"

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=7d

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM="Grasp Electric <noreply@graspelectric.com>"

# Admin notification email(s) - comma separated
ADMIN_EMAILS=admin@graspelectric.com

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
