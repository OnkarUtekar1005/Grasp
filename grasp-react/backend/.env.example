# Database Configuration
# Copy this file to .env and update with your credentials

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grasp_electric

# Individual connection parameters (alternative to DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=grasp_electric
# DB_USER=postgres
# DB_PASSWORD=postgres

# SSL mode for production
# DB_SSL=true

# Connection pool settings
# DB_POOL_MIN=2
# DB_POOL_MAX=10
